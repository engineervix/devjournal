  @if(entries.length > 0)
    <div class="space-y-4">
      @each(entry in entries)
        @!component('components/entry-card', { entry })
      @end

      {{-- Pagination --}}
      <nav class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 px-4 sm:px-0 my-6 pt-6">
        <div class="-mt-px flex w-0 flex-1">
          @if(entries.getMeta().currentPage > 1)
            <a
              href="{{ route('entries.index') }}?page={{ entries.getMeta().currentPage - 1 }}{{ queryParams }}"
              class="inline-flex items-center border-t-2 border-transparent pr-1 pt-4 text-sm font-medium text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-300"
            >
              <i class="ph ph-arrow-left mr-3"></i>
              Previous
            </a>
          @endif
        </div>

        <div class="hidden md:-mt-px md:flex">
          @each(page in range(1, entries.getMeta().lastPage + 1))
            <a
              href="{{ route('entries.index') }}?page={{ page }}{{ queryParams }}"
              class="{{ page === entries.getMeta().currentPage ? 'border-indigo-500 text-indigo-600 dark:text-indigo-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-300' }} inline-flex items-center border-t-2 px-4 pt-4 text-sm font-medium"
            >
              {{ page }}
            </a>
          @end
        </div>

        <div class="-mt-px flex w-0 flex-1 justify-end">
          @if(entries.getMeta().currentPage < entries.getMeta().lastPage)
            <a
              href="{{ route('entries.index') }}?page={{ entries.getMeta().currentPage + 1 }}{{ queryParams }}"
              class="inline-flex items-center border-t-2 border-transparent pl-1 pt-4 text-sm font-medium text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-300"
