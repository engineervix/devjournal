<!DOCTYPE html>
<html lang="en">
  <head>
    {{-- Common meta tags --}}
    @!component('components/meta/common', {
      description: 'Sign in to your DevJournal to track your development journey, learning progress, and coding achievements.'
    })

    <title>
      Login | DevJournal
    </title>

    {{-- Favicons --}}
    @!component('components/meta/favicons')

    {{-- OpenGraph and Twitter Card meta tags --}}
    @component('components/meta/opengraph', {
      title: 'Login | DevJournal',
      description: 'Sign in to your DevJournal to track your development journey, learning progress, and coding achievements.'
    })
      @slot('additional')
        {{-- Discourage indexing of login page --}}
        <meta name="robots" content="noindex, nofollow" />
      @end
    @end
    
    {{-- Prevent FOUC by initializing theme immediately --}}
    <script>
      // Initialize theme before any content renders to prevent flashing
      (function() {
        const storedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    @vite(['resources/css/app.css', 'resources/js/app.js'])

    {{-- Turnstile script - show when configured --}}
    @if(env.get('TURNSTILE_SITE_KEY'))
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer>
        
      </script>
      <script>
        document.addEventListener("DOMContentLoaded", function() {
          const loginForm = document.getElementById("loginForm");
          const submitButton = loginForm.querySelector('button[type="submit"]');
          // Function to check if Turnstile response exists
          function hasTurnstileResponse() {
            const turnstileResponse = document.querySelector('input[name="cf-turnstile-response"]');
            return turnstileResponse && turnstileResponse.value && turnstileResponse.value.trim() !== "";
          }
          // Prevent form submission without Turnstile response
          loginForm.addEventListener("submit", function(e) {
            if (!hasTurnstileResponse()) {
              e.preventDefault();
              alert("Please complete the security challenge before submitting.");
              return false;
            }
          });
          // Disable submit button until Turnstile is complete
          if (submitButton && typeof window.turnstile !== "undefined") {
            submitButton.disabled = true;
            submitButton.textContent = "Completing Security Check...";
            // Check for Turnstile completion periodically
            const checkInterval = setInterval(function() {
              if (hasTurnstileResponse()) {
                submitButton.disabled = false;
                submitButton.innerHTML = '<i class="ph ph-sign-in mr-2 group-hover:translate-x-1 transition-transform duration-200"></i>Sign In to DevJournal';
                clearInterval(checkInterval);
              }
            }, 500);
          }
        });
      </script>
    @endif
    
    {{-- Prevent Alpine.js FOUC --}}
    <style>
      [x-cloak] {
        display: none !important;
      }
      
      /* Custom login page styles */
      
      .login-bg {
        background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 50%, #e5e7eb 100%);
      }
      
      .dark .login-bg {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
      }
      
      .glass-effect {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      }
      
      .dark .glass-effect {
        background: rgba(31, 41, 55, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(75, 85, 99, 0.3);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }
      
      .floating-animation {
        animation: float 6s ease-in-out infinite;
      }
      
      .floating-animation:nth-child(2) {
        animation-delay: -2s;
      }
      
      .floating-animation:nth-child(3) {
        animation-delay: -4s;
      }
      
      @keyframes float {
        0%, 100% {
          transform: translateY(0px);
        }
      
        50% {
          transform: translateY(-20px);
        }
      }
      
      .code-pattern {
        background-image: linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px),
                                    linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px);
        background-size: 20px 20px;
      }
      
      .dark .code-pattern {
        background-image: linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px),
                                    linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
      }
      
      /* Turnstile widget styling */
      
      .cf-turnstile {
        border-radius: 0.75rem !important;
        overflow: hidden;
        max-width: 100%;
      }
      
      .cf-turnstile iframe {
        border-radius: 0.75rem !important;
        max-width: 100%;
      }
      
      /* Responsive adjustments for smaller screens */
      
      @media (max-height: 700px) {
        .login-container {
          padding-top: 2rem;
          padding-bottom: 2rem;
        }
      
        .login-form {
          padding: 1.5rem;
        }
      
        .login-header {
          margin-bottom: 1rem;
        }
      
        .login-footer {
          margin-top: 1rem;
          padding-top: 1rem;
        }
      }
      
      @media (max-height: 600px) {
        .floating-animation {
          display: none;
        }
      
        .login-container {
          align-items: flex-start;
          padding-top: 1rem;
          padding-bottom: 1rem;
        }
      
        .login-header {
          margin-bottom: 0.5rem;
        }
      
        .login-form {
          padding: 1rem;
        }
      
        .login-footer {
          margin-top: 0.5rem;
          padding-top: 0.5rem;
        }
      }
      
      /* Additional mobile optimizations */
      
      @media (max-width: 480px) {
        .cf-turnstile {
          transform: scale(0.9);
          transform-origin: center;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-900" x-data="{ showPassword: false }">
    {{-- Theme Toggle - Top Right Corner --}}
    <div class="fixed top-4 right-4 z-50">
      <button
        id="theme-toggle"
        class="w-12 h-12 rounded-full bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-all duration-200 backdrop-blur-sm border border-gray-200 dark:border-gray-600 hover:border-gray-300 dark:hover:border-gray-500 shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center"
      >
        <i class="ph ph-moon theme-icon-light text-gray-700 text-lg"></i>
        <i class="ph ph-sun theme-icon-dark text-gray-200 text-lg hidden"></i>
      </button>
    </div>

    {{-- Background with gradient and pattern --}}
    <div class="fixed inset-0 login-bg code-pattern">
    </div>
    {{-- Floating Code Elements --}}
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="floating-animation absolute top-20 left-10 text-gray-400/30 dark:text-gray-500/20 text-6xl font-mono"
      >
        &lt;/&gt;
      </div>
      <div
        class="floating-animation absolute top-40 right-20 text-gray-400/30 dark:text-gray-500/20 text-4xl font-mono"
      >
        { }
      </div>
      <div
        class="floating-animation absolute bottom-32 left-20 text-gray-400/30 dark:text-gray-500/20 text-5xl font-mono"
      >
        [ ]
      </div>
      <div
        class="floating-animation absolute bottom-20 right-10 text-gray-400/30 dark:text-gray-500/20 text-3xl font-mono"
      >
        ( )
      </div>
      <div
        class="floating-animation absolute top-1/2 left-1/4 text-gray-400/30 dark:text-gray-500/20 text-2xl font-mono"
      >
        console.log()
      </div>
      <div
        class="floating-animation absolute top-1/3 right-1/3 text-gray-400/30 dark:text-gray-500/20 text-2xl font-mono"
      >
        function()
      </div>
    </div>

    {{-- Main Login Container --}}
    <div
      class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 relative z-10 py-12 login-container"
    >
      <div class="max-w-md w-full space-y-6">
        {{-- Header --}}
        <div class="text-center login-header">
          <div
            class="mx-auto h-16 w-16 sm:h-20 sm:w-20 glass-effect rounded-2xl flex items-center justify-center mb-4 sm:mb-6 animate-bounce-subtle"
          >
            <i class="ph ph-code text-2xl sm:text-3xl text-indigo-600 dark:text-indigo-400"></i>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-2">
            DevJournal
          </h1>
          <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300">
            Track your development journey
          </p>
          <div
            class="mt-3 sm:mt-4 h-1 w-20 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto rounded-full"
          >
          </div>
        </div>

        {{-- Login Form --}}
        <div class="glass-effect rounded-2xl p-6 sm:p-8 shadow-2xl animate-slide-up login-form">
          <div class="text-center mb-4 sm:mb-6">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-2">
              Welcome Back
            </h2>
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">
              Sign in to continue your coding journey
            </p>
          </div>

          {{-- Error Message --}}
          @if(flashMessages.has('error'))
            <div
              class="mb-4 bg-red-500/20 border border-red-500/30 text-red-100 p-3 rounded-xl backdrop-blur-sm animate-fade-in"
            >
              <div class="flex items-center">
                <i class="ph ph-warning-circle text-red-300 mr-3"></i>
                <span>{{ flashMessages.get('error') }}</span>
              </div>
            </div>
          @endif
          
          <form action="{{ route('auth.login') }}" method="POST" class="space-y-5" id="loginForm">
            {{ csrfField() }}
            {{-- Email Field --}}
            <div class="space-y-2">
              <label for="email" class="block text-sm font-semibold text-gray-700 dark:text-gray-200">
                <i class="ph ph-envelope mr-2"></i>Email Address
            </label>
              <div class="relative">
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  autocomplete="email"
                  class="w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
                  placeholder="developer@example.com"
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                  <i class="ph ph-at text-gray-400 dark:text-gray-500"></i>
                </div>
              </div>
            </div>

            {{-- Password Field --}}
            <div class="space-y-2">
              <label for="password" class="block text-sm font-semibold text-gray-700 dark:text-gray-200">
                <i class="ph ph-lock mr-2"></i>Password
            </label>
              <div class="relative">
                <input
                  :type="showPassword ? 'text' : 'password'"
                  name="password"
                  id="password"
                  required
                  autocomplete="current-password"
                  class="w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 pr-12"
                  placeholder="Enter your password"
                />
                <button
                  type="button"
                  @click="showPassword = !showPassword"
                  class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200"
                >
                  <i class="ph ph-eye" x-show="!showPassword"></i>
                  <i class="ph ph-eye-slash" x-show="showPassword" x-cloak></i>
                </button>
              </div>
            </div>

            {{-- Turnstile Widget --}}
            @if(env.get('TURNSTILE_SITE_KEY'))
              <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-200">
                  <i class="ph ph-shield-check mr-2"></i>Security Check
              </label>
                <div class="flex justify-center">
                  <div
                    class="cf-turnstile glass-effect rounded-xl p-3"
                    data-sitekey="{{ env.get('TURNSTILE_SITE_KEY') }}"
                    data-theme="auto"
                    data-size="normal"
                  >
                  </div>
                </div>
              </div>
            @endif
            
            {{-- Login Button --}}
            <div class="pt-2">
              <button
                type="submit"
                class="group w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl"
              >
                <i class="ph ph-sign-in mr-2 group-hover:translate-x-1 transition-transform duration-200"></i>
                Sign In to DevJournal
            </button>
            </div>
          </form>

          {{-- Footer --}}
          <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-600 login-footer">
            <div class="text-center">
              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">
                Ready to level up your development skills?
              </p>
              <div class="mt-2 flex justify-center space-x-4 text-gray-400 dark:text-gray-500">
                <i class="ph ph-code text-base sm:text-lg"></i>
                <i class="ph ph-lightning text-base sm:text-lg"></i>
                <i class="ph ph-rocket text-base sm:text-lg"></i>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    {{-- Subtle particles effect --}}
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-1/4 left-1/4 w-2 h-2 bg-indigo-400/30 dark:bg-indigo-500/20 rounded-full animate-ping"
      >
      </div>
      <div
        class="absolute top-3/4 right-1/4 w-1 h-1 bg-purple-400/40 dark:bg-purple-500/25 rounded-full animate-pulse"
      >
      </div>
      <div
        class="absolute top-1/2 right-1/3 w-1.5 h-1.5 bg-indigo-500/35 dark:bg-indigo-400/20 rounded-full animate-ping"
        style="animation-delay: 2s;"
      >
      </div>
    </div>
  </body>
</html>
