<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title ?? 'DevJournal' }}</title>

  {{-- Font import --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {{-- Vite CSS and JS --}}
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col" data-new-entry-route="{{ route('entries.create') }}">
  {{-- Header --}}
  <header class="bg-white dark:bg-gray-800 shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <div class="flex items-center">
        <a href="{{ route('home') }}" class="font-bold text-xl text-indigo-600 dark:text-indigo-400">DevJournal</a>
      </div>

      <div class="flex items-center gap-4">
        {{-- Search Bar --}}
        <form action="{{ route('entries.search') }}" method="GET" class="hidden md:block">
          <div class="relative text-gray-500 dark:text-gray-400">
            <span class="absolute inset-y-0 left-0 flex items-center pl-2">
              <i class="ph ph-magnifying-glass"></i>
            </span>
            <input
              type="text"
              name="q"
              placeholder="Search entries..."
              class="py-2 pl-8 pr-4 bg-gray-100 dark:bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 w-64"
            />
          </div>
        </form>

        {{-- User menu/settings --}}
        <div class="relative" x-data="userMenu">
          <button @click="toggle" class="flex items-center focus:outline-none">
            <span class="hidden md:block mr-2">{{ auth.user.fullName ?? auth.user.email }}</span>
            <div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white">
              {{ auth.user.email.charAt(0).toUpperCase() }}
            </div>
          </button>

          <div x-show="open"
               @click.away="close"
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="transform opacity-0 scale-95"
               x-transition:enter-end="transform opacity-100 scale-100"
               x-transition:leave="transition ease-in duration-75"
               x-transition:leave-start="transform opacity-100 scale-100"
               x-transition:leave-end="transform opacity-0 scale-95"
               class="absolute right-0 mt-2 w-48 py-2 bg-white dark:bg-gray-800 rounded-md shadow-lg z-50"
               style="display: none;" {{-- Add style="display: none;" to prevent flash of unstyled content --}}
               >
            <a href="#" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Profile</a>
            <a href="#" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Settings</a>
            <form action="{{ route('auth.logout') }}" method="POST">
              {{ csrfField() }}
              <button type="submit" class="w-full text-left block px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                Logout
              </button>
            </form>
          </div>
        </div>

        {{-- Theme toggle --}}
        <button id="theme-toggle" class="p-2 rounded-md hover:bg-gray-100 dark:hover:bg-gray-700">
          <i class="ph ph-moon theme-icon-light"></i>
          <i class="ph ph-sun theme-icon-dark"></i>
        </button>
      </div>
    </div>
  </header>

  {{-- Main Content --}}
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    {{{ await $slots.main() }}}
  </main>

  {{-- Quick Entry Button --}}
  <div class="fixed right-6 bottom-6">
    <a href="{{ route('entries.create') }}"
       class="flex items-center justify-center w-14 h-14 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="ph ph-plus text-xl"></i>
    </a>
  </div>

  {{-- Footer --}}
  <footer class="bg-white dark:bg-gray-800 shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <p class="text-center text-sm text-gray-500 dark:text-gray-400">
        DevJournal &copy; {{ new Date().getFullYear() }}
      </p>
    </div>
  </footer>

  {{-- Page specific scripts --}}
  @stack('scripts')
</body>
</html>
