{{-- Enhanced style mapping for entry types --}}
@let(entryTypeConfig = {
  daily: {
    gradient: 'from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20',
    border: 'border-blue-200 dark:border-blue-800/30',
    badge: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200',
    icon: 'ph-calendar-check',
    iconBg: 'bg-blue-500 dark:bg-blue-600'
  },
  til: {
    gradient: 'from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20',
    border: 'border-green-200 dark:border-green-800/30',
    badge: 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-200',
    icon: 'ph-lightbulb',
    iconBg: 'bg-green-500 dark:bg-green-600'
  },
  snippet: {
    gradient: 'from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20',
    border: 'border-purple-200 dark:border-purple-800/30',
    badge: 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-200',
    icon: 'ph-code',
    iconBg: 'bg-purple-500 dark:bg-purple-600'
  },
  debug: {
    gradient: 'from-orange-50 to-orange-100 dark:from-orange-900/20 dark:to-orange-800/20',
    border: 'border-orange-200 dark:border-orange-800/30',
    badge: 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-200',
    icon: 'ph-bug',
    iconBg: 'bg-orange-500 dark:bg-orange-600'
  },
  achievement: {
    gradient: 'from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20',
    border: 'border-pink-200 dark:border-pink-800/30',
    badge: 'bg-pink-100 text-pink-800 dark:bg-pink-900/50 dark:text-pink-200',
    icon: 'ph-trophy',
    iconBg: 'bg-pink-500 dark:bg-pink-600'
  }
})

@let(config = entryTypeConfig[entry.entryType] || {
  gradient: 'from-gray-50 to-gray-100 dark:from-gray-800/50 dark:to-gray-900/50',
  border: 'border-gray-200 dark:border-gray-700',
  badge: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
  icon: 'ph-file-text',
  iconBg: 'bg-gray-500 dark:bg-gray-600'
})

{{-- Enhanced Entry Card with Full Click Support --}}
<article
  class="group relative entry-card-clickable bg-gradient-to-br {{ config.gradient }} border {{ config.border }} rounded-xl overflow-hidden shadow-sm hover:shadow-lg cursor-pointer"
  x-data="clickableCard"
  x-init="targetUrl = '{{ route('entries.show', { id: entry.id }) }}'"
  @click="handleClick($event)"
  @mousedown="handleMouseDown($event)"
  tabindex="0"
  role="button"
  aria-label="View entry: {{ entry.title || 'Untitled Entry' }}"
>
  {{-- Header --}}
  <div class="px-6 py-4 border-b border-gray-200/50 dark:border-gray-700/50">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        {{-- Entry Type Icon --}}
        <div class="w-10 h-10 {{ config.iconBg }} rounded-lg flex items-center justify-center flex-shrink-0">
          <i class="ph {{ config.icon }} text-white text-lg"></i>
        </div>

        {{-- Entry Type Badge & Date --}}
        <div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {{ config.badge }}">
            {{ entry.entryType.toUpperCase() }}
          </span>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
            {{ formatDateWithDay(entry.createdAt, 'medium') }}
          </p>
        </div>
      </div>

      {{-- Action buttons --}}
      <div
        class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 relative z-10"
      >
        <a
          href="{{ route('entries.edit', { id: entry.id }) }}"
          class="p-2 text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-white dark:hover:bg-gray-800 rounded-lg transition-colors duration-200"
          title="Edit entry"
          @click.stop
        >
          <i class="ph ph-pencil text-sm"></i>
        </a>
        <form
          action="{{ route('entries.destroy', { id: entry.id }) }}"
          method="POST"
          class="inline"
          @click.stop
        >
          {{ csrfField() }}
          <button
            type="submit"
            class="p-2 text-gray-500 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-white dark:hover:bg-gray-800 rounded-lg transition-colors duration-200"
            onclick="return confirm('Are you sure you want to delete this entry?')"
            title="Delete entry"
          >
            <i class="ph ph-trash text-sm"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  {{-- Content --}}
  <div class="px-6 py-5">
    {{-- Title --}}
    @if(entry.title)
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 line-clamp-2">
        {{ entry.title }}
      </h3>
    @end
    
    {{-- Content Preview --}}
    <div class="prose prose-sm dark:prose-invert max-w-none">
      @if(entry.contentHtml)
        @if(searchQuery)
          {{-- Search results preview --}}
          <div class="text-gray-700 dark:text-gray-300 line-clamp-3 mb-3">
            {{ entry.contentPlain ? entry.contentPlain.substring(0, 200) + (entry.contentPlain.length > 200 ? '...' : '') : 'No content preview available' }}
          </div>
          <span class="inline-flex items-center text-sm text-indigo-600 dark:text-indigo-400 font-medium">
            Read full entry
            <i class="ph ph-arrow-right ml-1"></i>
          </span>
        @else
          {{-- Full content with line clamp for long entries --}}
          <div class="line-clamp-4">
            {{{ entry.contentHtml }}}
          </div>
          @if(entry.contentPlain && entry.contentPlain.length > 300)
            <span class="inline-flex items-center text-sm text-indigo-600 dark:text-indigo-400 font-medium mt-2">
              Continue reading
              <i class="ph ph-arrow-right ml-1"></i>
            </span>
          @end
        @end
      @else
        <p class="text-gray-500 dark:text-gray-400 italic">
          No content
        </p>
      @end
    </div>

    {{-- Tags --}}
    @if(entry.tags && entry.tags.length > 0)
      <div class="mt-4 pt-4 border-t border-gray-200/50 dark:border-gray-700/50">
        <div class="flex flex-wrap gap-2">
          @each(tag in entry.tags)
            <a
              href="{{ route('entries.byTag', { slug: tag.slug }) }}"
              class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium
                      bg-indigo-50 text-indigo-700 hover:bg-indigo-100 hover:scale-105
                      dark:bg-indigo-900/30 dark:text-indigo-300 dark:hover:bg-indigo-900/50
                      transition-all duration-200 relative z-10"
              @click.stop
            >
              #{{ tag.name }}
            </a>
          @end
        </div>
      </div>
    @end
  </div>

  {{-- Visual indicator for clickability --}}
  <div
    class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-indigo-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none"
  >
  </div>
</article>
