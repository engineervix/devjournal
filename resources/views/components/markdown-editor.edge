{{-- Markdown Editor Component --}}
<div x-data="markdownEditor" x-init="init({{ JSON.stringify(initialContent || '') }})" class="mb-6">
  <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Content</label>

  {{-- Tabs --}}
  <div class="mb-2 border-b border-gray-200 dark:border-gray-700">
    <ul class="flex flex-wrap -mb-px">
      <li class="mr-2">
        <button
          @click="activeTab = 'write'"
          :class="activeTab === 'write' ? 'border-indigo-500 text-indigo-600 dark:text-indigo-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
          class="inline-flex items-center py-2 px-4 text-sm font-medium border-b-2 focus:outline-none"
          type="button"
        >
          <i class="ph ph-pencil mr-1"></i>
          Write
        </button>
      </li>
      <li class="mr-2">
        <button
          @click="activeTab = 'preview'; renderPreview()"
          :class="activeTab === 'preview' ? 'border-indigo-500 text-indigo-600 dark:text-indigo-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
          class="inline-flex items-center py-2 px-4 text-sm font-medium border-b-2 focus:outline-none"
          type="button"
        >
          <i class="ph ph-eye mr-1"></i>
          Preview
        </button>
      </li>
    </ul>
  </div>

  {{-- Editor --}}
  <div class="relative rounded-md border border-gray-300 dark:border-gray-600 min-h-64">
    {{-- Write Tab --}}
    <div x-show="activeTab === 'write'">
      <textarea
        id="content"
        name="contentMarkdown"
        x-model="content"
        class="h-64 w-full p-3 border-0 rounded-md bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 focus:ring-indigo-500 focus:border-indigo-500 resize-none overflow-auto font-mono text-sm"
        placeholder="Start writing in Markdown..."
      ></textarea>
    </div>

    {{-- Preview Tab --}}
    <div
      x-show="activeTab === 'preview'"
      class="h-64 w-full p-3 overflow-auto bg-gray-50 dark:bg-gray-900 rounded-md"
    >
      <div x-html="preview" class="prose dark:prose-invert max-w-none prose-sm"></div>
      <div class="mt-4 p-2 bg-blue-50 dark:bg-blue-900/30 rounded text-xs text-blue-700 dark:text-blue-300">
        <i class="ph ph-info mr-1"></i>
        Note: This is a basic preview. The final rendering may differ slightly.
      </div>
    </div>

    {{-- Keyboard shortcuts --}}
    <div class="absolute bottom-2 right-2 text-xs text-gray-500 dark:text-gray-400 pointer-events-none bg-white dark:bg-gray-800 px-2 py-1 rounded">
      <span>Cmd/Ctrl + Enter to save</span>
    </div>
  </div>
</div>
