{{-- Markdown Editor Component --}}
<div x-data="markdownEditor" x-init="init({{ JSON.stringify(initialContent || '') }})" class="mb-6">
  <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Content</label>

  {{-- Tabs --}}
  <div class="mb-2 border-b border-gray-200 dark:border-gray-700">
    <ul class="flex flex-wrap -mb-px">
      <li class="mr-2">
        <button
          @click="activeTab = 'write'"
          :class="activeTab === 'write' ? 'border-indigo-500 text-indigo-600 dark:text-indigo-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
          class="inline-flex items-center py-2 px-4 text-sm font-medium border-b-2 focus:outline-none"
          type="button"
        >
          Write
        </button>
      </li>
      <li class="mr-2">
        <button
          @click="activeTab = 'preview'; renderPreview()"
          :class="activeTab === 'preview' ? 'border-indigo-500 text-indigo-600 dark:text-indigo-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
          class="inline-flex items-center py-2 px-4 text-sm font-medium border-b-2 focus:outline-none"
          type="button"
        >
          Preview
        </button>
      </li>
    </ul>
  </div>

  {{-- Editor --}}
  <div class="relative rounded-md border border-gray-300 dark:border-gray-600 min-h-64">
    {{-- Write Tab --}}
    <div x-show="activeTab === 'write'">
      <textarea
        id="content"
        name="contentMarkdown"
        x-model="content"
        class="h-64 w-full p-3 border-0 rounded-md bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 focus:ring-indigo-500 focus:border-indigo-500 resize-none overflow-auto"
        placeholder="Start writing..."
      ></textarea>
    </div>

    {{-- Preview Tab --}}
    <div
      x-show="activeTab === 'preview'"
      x-html="preview"
      class="h-64 w-full p-3 overflow-auto prose dark:prose-invert max-w-none"
    ></div>

    {{-- Keyboard shortcuts --}}
    <div class="absolute bottom-2 right-2 text-xs text-gray-500 dark:text-gray-400 pointer-events-none">
      <span>Cmd/Ctrl + Enter to save</span>
    </div>
  </div>
</div>
