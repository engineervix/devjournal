{{-- Keyboard Shortcut Display Component --}}
{{--
  Usage: @!component('components/keyboard-shortcut', { shortcut: 's', action: 'save' })
  Props:
  - shortcut: The key to combine with the modifier (e.g., 's', 'n', '/')
  - action: Optional action description
  - cssClass: Optional CSS classes
--}}

<span class="{{ cssClass || 'inline-flex items-center gap-1' }}">
  @if(request.header('user-agent', '').includes('Mac'))
    <kbd class="kbd kbd-mac">⌘</kbd>    <kbd class="kbd">{{ (shortcut || 's').toUpperCase() }}</kbd>
  @else
    <kbd class="kbd">Ctrl</kbd>    <kbd class="kbd">+</kbd>    <kbd class="kbd">{{ (shortcut || 's').toUpperCase() }}</kbd>
  @endif
  @if(action)
    <span class="ml-1">{{ action }}</span>
  @endif
</span>
