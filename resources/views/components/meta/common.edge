{{-- Common HTML meta tags --}}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="csrf-token" content="{{ csrfToken }}" />

{{-- Standard meta description for SEO --}}
<meta
  name="description"
  content="{{ description || 'The developer\'s journal for daily logs, learning notes, and career achievements. Self-hosted, keyboard-driven, built for engineering growth.' }}"
/>
