{{-- resources/views/components/form_validation_errors.edge --}}
@if(flashMessages.has('errors'))
  <div
    class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6"
  >
    <div class="flex">
      <div class="flex-shrink-0">
        <i class="ph ph-warning text-red-400 text-xl"></i>        {{-- Added text-xl for consistency with other icons --}}
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
          There were errors with your submission
        </h3>
        <div class="mt-2 text-sm text-red-700 dark:text-red-300">
          <ul class="list-disc pl-5 space-y-1">
            @each(error in flashMessages.get('errors'))
              <li>
                {{ error }}
              </li>
            @end
          </ul>
        </div>
      </div>
    </div>
  </div>
@endif
