{{-- Type selector component for entry creation/editing --}}
<div x-data="{ selected: '{{ entryType || 'daily' }}' }" class="mb-6" x-cloak>
  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Entry Type</label>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
    <button
      type="button"
      @click="selected = 'daily'"
      :class="selected === 'daily' ? 'ring-2 ring-indigo-500' : 'ring-1 ring-gray-300 dark:ring-gray-600'"
      class="col-span-1 relative bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm hover:border-gray-400 focus:outline-none"
    >
      <span class="flex items-center">
        <span class="text-xl text-blue-500 mr-2">
          <i class="ph ph-calendar-check"></i>
        </span>
        <span class="flex flex-col text-left">
          <span class="block text-sm font-medium">Daily Log</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400">Track daily activities</span>
        </span>
      </span>
      <input type="radio" name="entryType" value="daily" :checked="selected === 'daily'" class="hidden" />
    </button>

    <button
      type="button"
      @click="selected = 'til'"
      :class="selected === 'til' ? 'ring-2 ring-indigo-500' : 'ring-1 ring-gray-300 dark:ring-gray-600'"
      class="col-span-1 relative bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm hover:border-gray-400 focus:outline-none"
    >
      <span class="flex items-center">
        <span class="text-xl text-green-500 mr-2">
          <i class="ph ph-lightbulb"></i>
        </span>
        <span class="flex flex-col text-left">
          <span class="block text-sm font-medium">Today I Learned</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400">New knowledge</span>
        </span>
      </span>
      <input type="radio" name="entryType" value="til" :checked="selected === 'til'" class="hidden" />
    </button>

    <button
      type="button"
      @click="selected = 'snippet'"
      :class="selected === 'snippet' ? 'ring-2 ring-indigo-500' : 'ring-1 ring-gray-300 dark:ring-gray-600'"
      class="col-span-1 relative bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm hover:border-gray-400 focus:outline-none"
    >
      <span class="flex items-center">
        <span class="text-xl text-purple-500 mr-2">
          <i class="ph ph-code"></i>
        </span>
        <span class="flex flex-col text-left">
          <span class="block text-sm font-medium">Code Snippet</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400">Useful code samples</span>
        </span>
      </span>
      <input type="radio" name="entryType" value="snippet" :checked="selected === 'snippet'" class="hidden" />
    </button>

    <button
      type="button"
      @click="selected = 'debug'"
      :class="selected === 'debug' ? 'ring-2 ring-indigo-500' : 'ring-1 ring-gray-300 dark:ring-gray-600'"
      class="col-span-1 relative bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm hover:border-gray-400 focus:outline-none"
    >
      <span class="flex items-center">
        <span class="text-xl text-orange-500 mr-2">
          <i class="ph ph-bug"></i>
        </span>
        <span class="flex flex-col text-left">
          <span class="block text-sm font-medium">Debug Session</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400">Problem solving</span>
        </span>
      </span>
      <input type="radio" name="entryType" value="debug" :checked="selected === 'debug'" class="hidden" />
    </button>

    <button
      type="button"
      @click="selected = 'achievement'"
      :class="selected === 'achievement' ? 'ring-2 ring-indigo-500' : 'ring-1 ring-gray-300 dark:ring-gray-600'"
      class="col-span-1 relative bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm hover:border-gray-400 focus:outline-none"
    >
      <span class="flex items-center">
        <span class="text-xl text-pink-500 mr-2">
          <i class="ph ph-medal"></i>
        </span>
        <span class="flex flex-col text-left">
          <span class="block text-sm font-medium">Achievement</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400">Celebrate wins</span>
        </span>
      </span>
      <input
        type="radio"
        name="entryType"
        value="achievement"
        :checked="selected === 'achievement'"
        class="hidden"
      />
    </button>
  </div>

  {{-- Entry Templates for different entry types --}}
  {{-- Note: Using insertTemplateWithRetry() to work around EasyMDE timing issue --}}
  {{-- where template insertion sometimes requires two clicks to work properly --}}
  @component('components/entry-type-selector/template-block', { entryType: 'daily', title: 'Daily Log Template', containerClass: 'bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800', headingClass: 'text-blue-800 dark:text-blue-200', textClass: 'text-blue-700 dark:text-blue-300' })
    @include('components/entry-type-selector/templates/daily')
  @end
  
  @component('components/entry-type-selector/template-block', { entryType: 'til', title: 'TIL Template', containerClass: 'bg-green-50 dark:bg-green-900/30 border border-green-100 dark:border-green-800', headingClass: 'text-green-800 dark:text-green-200', textClass: 'text-green-700 dark:text-green-300' })
    @include('components/entry-type-selector/templates/til')
  @end
  
  @component('components/entry-type-selector/template-block', { entryType: 'snippet', title: 'Code Snippet Template', containerClass: 'bg-purple-50 dark:bg-purple-900/30 border border-purple-100 dark:border-purple-800', headingClass: 'text-purple-800 dark:text-purple-200', textClass: 'text-purple-700 dark:text-purple-300' })
    @include('components/entry-type-selector/templates/snippet')
  @end
  
  @component('components/entry-type-selector/template-block', { entryType: 'debug', title: 'Debug Session Template', containerClass: 'bg-orange-50 dark:bg-orange-900/30 border border-orange-100 dark:border-orange-800', headingClass: 'text-orange-800 dark:text-orange-200', textClass: 'text-orange-700 dark:text-orange-300' })
    @include('components/entry-type-selector/templates/debug')
  @end
  
  @component('components/entry-type-selector/template-block', { entryType: 'achievement', title: 'Achievement Template', containerClass: 'bg-pink-50 dark:bg-pink-900/30 border border-pink-100 dark:border-pink-800', headingClass: 'text-pink-800 dark:text-pink-200', textClass: 'text-pink-700 dark:text-pink-300' })
    @include('components/entry-type-selector/templates/achievement')
  @end
</div>
